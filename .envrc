if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

# hw.logicalcpu is the macOS CPU probe supported here. Keep other platforms on
# their existing Nix settings instead of assuming they provide the same probe.
if [ "$(uname -s)" = "Darwin" ]; then
  openmeter_nix_logical_cpus="$(sysctl -n hw.logicalcpu 2>/dev/null || true)"

  if [[ "${openmeter_nix_logical_cpus}" =~ ^[1-9][0-9]*$ ]]; then
    openmeter_nix_cores_per_job=2
    if [ "${openmeter_nix_logical_cpus}" -lt "${openmeter_nix_cores_per_job}" ]; then
      openmeter_nix_cores_per_job=1
    fi
    openmeter_nix_max_jobs=$((openmeter_nix_logical_cpus / openmeter_nix_cores_per_job))

    # max-jobs controls concurrent derivations while cores controls parallelism
    # inside each derivation. Match CI's two-core jobs while keeping their total
    # advertised parallelism within the detected CPU budget.
    export NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG}
}max-jobs = ${openmeter_nix_max_jobs}
cores = ${openmeter_nix_cores_per_job}"
  fi

  unset openmeter_nix_cores_per_job openmeter_nix_logical_cpus openmeter_nix_max_jobs
fi

use flake . --impure

dotenv_if_exists .env.local
