+import { createComponent as _$createComponent } from "@alloy-js/core/jsx-runtime";
+import { Tester } from "#test/test-host.js";
+import { t } from "@typespec/compiler/testing";
+import { describe, expect, it } from "vitest";
+import { getOutput } from "../../test-utils.js";
+import { Method } from "./class-method.js";
+import { PydanticClassDeclaration } from "./pydantic-class-declaration.js";
+import { computedFieldDecorator, fieldSerializerDecorator, fieldValidatorDecorator, modelValidatorDecorator } from "./pydantic-decorators.js";
+describe("Python pydantic decorator helpers", () => {
+  it("builds @field_validator decorator with mode", async () => {
+    const {
+      program,
+      normalizeName
+    } = await Tester.compile(t.code`@test op ${t.op("normalizeName")}(value: string): string;`);
+    expect(getOutput(program, [_$createComponent(PydanticClassDeclaration, {
+      name: "User",
+      get children() {
+        return _$createComponent(Method, {
+          type: normalizeName,
+          methodType: "class",
+          get decorators() {
+            return [fieldValidatorDecorator("name", {
+              mode: "before"
+            })];
+          }
+        });
+      }
+    })])).toRenderTo(`
+      from pydantic import BaseModel
+      from pydantic import field_validator
+
+
+      class User(BaseModel):
+          @field_validator("name", mode="before")
+          @classmethod
+          def normalize_name(cls, value: str) -> str:
+              pass
+
+
+    `);
+  });
+  it("builds @model_validator decorator for class methods", async () => {
+    const {
+      program,
+      checkModel
+    } = await Tester.compile(t.code`@test op ${t.op("checkModel")}(value: string): string;`);
+    expect(getOutput(program, [_$createComponent(PydanticClassDeclaration, {
+      name: "User",
+      get children() {
+        return _$createComponent(Method, {
+          type: checkModel,
+          methodType: "class",
+          get decorators() {
+            return [modelValidatorDecorator({
+              mode: "after"
+            })];
+          }
+        });
+      }
+    })])).toRenderTo(`
+      from pydantic import BaseModel
+      from pydantic import model_validator
+
+
+      class User(BaseModel):
+          @model_validator(mode="after")
+          @classmethod
+          def check_model(cls, value: str) -> str:
+              pass
+
+
+    `);
+  });
+  it("builds serializer and computed field decorators", async () => {
+    const {
+      program
+    } = await Tester.compile(``);
+    expect(getOutput(program, [_$createComponent(PydanticClassDeclaration, {
+      name: "User",
+      get children() {
+        return [_$createComponent(Method, {
+          name: "serializeName",
+          methodType: "method",
+          returnType: "str",
+          get decorators() {
+            return [fieldSerializerDecorator("name", {
+              whenUsed: "json"
+            })];
+          }
+        }), _$createComponent(Method, {
+          name: "displayName",
+          methodType: "method",
+          returnType: "str",
+          get decorators() {
+            return [computedFieldDecorator()];
+          }
+        })];
+      }
+    })])).toRenderTo(`
+      from pydantic import BaseModel
+      from pydantic import computed_field
+      from pydantic import field_serializer
+
+
+      class User(BaseModel):
+          @field_serializer("name", when_used="json")
+          def serialize_name(self) -> str:
+              pass
+          @computed_field
+          def display_name(self) -> str:
+              pass
+
+
+    `);
+  });
+});
