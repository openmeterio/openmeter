+export const fileRef = {
+    /**
+     * Create a {@link FileRef} pointing to a file relative to the package root (the directory
+     * containing the library's `package.json`).
+     *
+     * @example
+     * ```ts
+     * docs: fileRef.fromPackageRoot("src/rules/my-rule.md"),
