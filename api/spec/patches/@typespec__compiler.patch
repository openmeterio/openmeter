+        const templates = JSON.parse(indexFile.text);
+        return { templates, indexFile, baseUri: INTERNAL_URI_PREFIX };
+    }
+    async readFile(relativePath) {
+        return this.#read(relativePath);
+    }
+    #read(relativePath) {
